local function FireRemote(remoteName, ...)
	local remote = Remotes:FindFirstChild(remoteName)
	if not remote then
		return false
	end

	if remote:IsA("RemoteEvent") then
		return pcall(function()
			remote:FireServer()
		end)
	end

	return false
end

local function InvokeRemote(remoteName, ...)
	local remote = Remotes:FindFirstChild(remoteName)
	if not remote then
		return false, nil
	end

	if remote:IsA("RemoteFunction") then
		return pcall(function()
			return remote:InvokeServer()
		end)
	end

	return false, nil
end

local State = {
	AutoBuy = false,
	AutoAscend = false,
	AutoClicker = false,
	AutoRoll = false,

	StartUpgrade = 1,
	EndUpgrade = 100,
	BuyDelay = 0.10,

	AscendDelay = 0.50,
	ClickerDelay = 0.10,
	RollDelay = 1.00,

	ManualUpgrade = 1,
	SelectedChallenge = "BigBang",
}

local Threads = {}
local ToggleElements = {}
local AutoKeys = { "AutoBuy", "AutoAscend", "AutoClicker", "AutoRoll" }

local function CancelThread(key)
	local thread = Threads[key]
	if thread then
		pcall(task.cancel, thread)
		Threads[key] = nil
	end
end

local function StopAuto(key)
	State[key] = false
	CancelThread(key)

	if ToggleElements[key] then
		pcall(function()
			ToggleElements[key]:Set(false)
		end)
	end
end

local function StopAllAuto()
	for _, key in ipairs(AutoKeys) do
		StopAuto(key)
	end

	Rayfield:Notify({
		Title = "Automation Stopped",
		Content = "All auto loops have been stopped.",
		Duration = 4,
		Image = 4400697855,
	})
end

local function SafeNumber(value, default)
	local n = tonumber(value)
	if not n then
		return default
	end
	return n
end

local function StartAutoLoop(key, action, getDelay)
	CancelThread(key)

	Threads[key] = task.spawn(function()
		while State[key] do
			local ok, err = pcall(action)
			if not ok then
				warn("ZETHUB | Auto loop error (" .. key .. "): " .. tostring(err))
			end

			local delay = getDelay and getDelay() or 0.10
			if delay < 0.03 then
				delay = 0.03
			end

			task.wait(delay)
		end

		Threads[key] = nil
	end)
end

local function StartAutoBuy()
	CancelThread("AutoBuy")

	Threads.AutoBuy = task.spawn(function()
		while State.AutoBuy do
			local startValue = math.clamp(math.floor(State.StartUpgrade), 1, 999)
			local endValue = math.clamp(math.floor(State.EndUpgrade), 1, 999)

			if startValue > endValue then
				startValue, endValue = endValue, startValue
			end

			for i = startValue, endValue do
				if not State.AutoBuy then
					break
				end

				FireRemote("BuyUpg", i)
				task.wait(math.max(State.BuyDelay, 0.03))
			end

			if State.AutoBuy then
				task.wait(math.max(State.BuyDelay, 0.03))
			end
		end

		Threads.AutoBuy = nil
	end)
end

